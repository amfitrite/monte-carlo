//@version=6
indicator("Monte Carlo Matrix & Multi-Day Forward Bands [v6]", overlay = true, max_polylines_count = 100, max_lines_count = 100, max_labels_count = 100)

//---------------------------------------------------------------------------------------------------------------------}
// 1. Inputs & Configuration
//---------------------------------------------------------------------------------------------------------------------{

// --- Execution & Refresh Timing ---
grp_exec      = "Execution & Refresh Control"
throttle_sec  = input.int(15, title = "Live Update Interval (Seconds)", minval = 1, maxval = 300, tooltip = "Auto-hitung di bar live tiap N detik agar stabil dan bebas lag.", group = grp_exec)
replay_mode   = input.bool(true, title = "Support Bar Replay", tooltip = "Update otomatis setiap bar baru maju di mode Bar Replay.", group = grp_exec)

// --- Horizon & 3-Day Forward Projection Modes ---
grp_proj      = "Forward Horizon & Multi-Day Options"
proj_mode     = input.string("Calendar 3 Days Forward", title = "Horizon Target", options = ["Calendar 3 Days Forward", "Trading Sessions (3 Days)", "Manual Bar Count"], tooltip = "Opsi proyeksi: mengonversi durasi waktu ke jumlah bar otomatis sesuai timeframe chart.", group = grp_proj)
custom_bars   = input.int(30, title = "Manual Horizon (If Manual)", minval = 5, maxval = 300, group = grp_proj)

// --- Monte Carlo Matrix & Permutations ---
grp_mc        = "Monte Carlo Permutation Engine"
lookback_bars = input.int(100, title = "Historical Lookback (Pool Size)", minval = 20, maxval = 499, tooltip = "Total pool candle masa lalu yang dijadikan sampel pergerakan.", group = grp_mc)
num_replays   = input.int(100, title = "Replay Runs (Iterations)", minval = 10, maxval = 200, tooltip = "Jumlah lintasan simulasi Monte Carlo yang dijalankan.", group = grp_mc)
kombinasi_pct = input.int(50, title = "Kombinasi Subsample (% of Horizon)", minval = 20, maxval = 100, tooltip = "Persentase ukuran sample window relatif terhadap horizon bar.", group = grp_mc)
var_method    = input.string("Subsample Kombinasi", title = "Variation Method", options = ["Subsample Kombinasi", "Block Permutation", "Sign-Flipping Drift", "Uniform Shuffle"], tooltip = "Metode variasi sampling data historis.", group = grp_mc)

// --- Visual Probability Bands & Modern Theme ---
grp_vis       = "Probability Bands Visuals"
theme_mode    = input.string("Neon Matrix (Cyan/Blue)", title = "Color Theme Preset", options = ["Neon Matrix (Cyan/Blue)", "Dark Gradient (Amber/Violet)", "Monochrome Ghost"], group = grp_vis)

show_shadow   = input.bool(true, title = "Show Min/Max Shadow Band", group = grp_vis)
show_stdev    = input.bool(true, title = "Show StdDev Confidence Band", group = grp_vis)
stdev_multi   = input.float(1.5, title = "StdDev Multiplier", minval = 0.1, step = 0.5, group = grp_vis)
show_mean     = input.bool(true, title = "Show Center Mean Path", group = grp_vis)

// --- Target Projections (End of Day 1, 2, 3) ---
grp_targets   = "Forward Day Milestones (Day 1, 2, 3)"
show_milest   = input.bool(true, title = "Show Day 1, 2, 3 Projected Milestone Labels", group = grp_targets)

// --- Modern Quantitative Entry Strategies ---
grp_strat     = "Entry Strategy Templates"
enable_entry  = input.bool(true, title = "Enable Entry Signals", group = grp_strat)
strat_type    = input.string("Mean Reversion: Touch / Fade", title = "Strategy Template", options = ["Mean Reversion: Touch / Fade", "Mean Reversion: Re-entry Confirmation", "Volatility Breakout: Momentum Expansion", "Mean Path Pullback: Trend Retest", "Asymmetric Skew: Quantitative Probability Bias"], tooltip = "Pola interaksi harga terhadap pita proyeksi Monte Carlo.", group = grp_strat)
prob_skew_pct = input.int(65, title = "Skew Threshold % (for Asymmetric Skew)", minval = 50, maxval = 90, step = 5, group = grp_strat)

// --- Modern HUD Summary Box ---
grp_hud       = "Dashboard HUD Metrics"
show_hud      = input.bool(true, title = "Show Monte Carlo Metrics Dashboard", group = grp_hud)
hud_position  = input.string("Top Right", title = "HUD Position", options = ["Top Right", "Bottom Right", "Top Left"], group = grp_hud)

//---------------------------------------------------------------------------------------------------------------------}
// 2. Dynamic Forward Horizon Calculator (3 Hari ke Depan)
//---------------------------------------------------------------------------------------------------------------------{
calc_bars_per_day() =>
    float minutes_per_bar = 60.0
    if timeframe.isdaily
        minutes_per_bar := 1440.0
    else if timeframe.isminutes
        minutes_per_bar := float(timeframe.multiplier)
    else if timeframe.isseconds
        minutes_per_bar := float(timeframe.multiplier) / 60.0
    else if timeframe.isdwm
        minutes_per_bar := 1440.0 * float(timeframe.multiplier)
    
    float active_hours = (proj_mode == "Trading Sessions (3 Days)") ? 6.5 : 24.0
    int bars_1d = math.max(1, math.round((active_hours * 60.0) / math.max(minutes_per_bar, 1.0)))
    bars_1d

bars_per_1d = calc_bars_per_day()

// Total bar horizon 3 hari ke depan
int forward_bars = 30
if proj_mode == "Calendar 3 Days Forward" or proj_mode == "Trading Sessions (3 Days)"
    forward_bars := bars_per_1d * 3
else
    forward_bars := custom_bars

forward_bars := math.clamp(forward_bars, 5, 250)

// Preset Tema Warna
color c_shadow = color.new(#787b86, 85)
color c_stdev  = color.new(#2962ff, 80)
color c_mean   = #2962ff

if theme_mode == "Neon Matrix (Cyan/Blue)"
    c_shadow := color.new(#00e5ff, 90)
    c_stdev  := color.new(#2979ff, 75)
    c_mean   := #00e5ff
else if theme_mode == "Dark Gradient (Amber/Violet)"
    c_shadow := color.new(#ff6d00, 90)
    c_stdev  := color.new(#7c4dff, 75)
    c_mean   := #ffd600
else if theme_mode == "Monochrome Ghost"
    c_shadow := color.new(#b0bec5, 90)
    c_stdev  := color.new(#78909c, 80)
    c_mean   := #eceff1

//---------------------------------------------------------------------------------------------------------------------}
// 3. User Defined Types (UDT) & Buffer Storage
//---------------------------------------------------------------------------------------------------------------------{
type fa
    array<float> ary

var array<float> can_ary = array.new_float(0)

// Visual element state handles
var polyline shadow_poly = na
var polyline stdev_poly  = na
var polyline mean_poly   = na

// Milestone handles (Day 1, 2, 3)
var label lbl_day1 = na
var label lbl_day2 = na
var label lbl_day3 = na
var line  ln_day1  = na
var line  ln_day2  = na
var line  ln_day3  = na

// HUD Dashboard Table handle
var table hud_tbl = na

// Timing state
var int last_calc_time = 0

// Populate movement buffer (close - open)
movement = close - open
array.push(can_ary, movement)
if array.size(can_ary) > lookback_bars
    array.shift(can_ary)

//---------------------------------------------------------------------------------------------------------------------}
// 4. Engine Functions (Preserving Core Pseudo-Random Algorithmic Design)
//---------------------------------------------------------------------------------------------------------------------{
is_odd(int _num) => 
    (_num / 2.0) - math.floor(_num / 2.0) > 0

random_in_range(int seed, int min_val, int max_val) => 
    min_val + (((1103515245 * seed + 12345) % 2147483647) % ((max_val + 1) - min_val))

build_mc_permutation(array<float> pool, int k_len, string mode, int seed_val) =>
    array<float> sample_out = array.new_float(0)
    int pool_size = array.size(pool)
    
    if pool_size > 0
        if mode == "Subsample Kombinasi"
            for step = 0 to k_len - 1
                int r_idx = random_in_range(seed_val + step * 17, 0, pool_size - 1)
                array.push(sample_out, array.get(pool, r_idx))
                
        else if mode == "Block Permutation"
            int num_blocks = math.ceil(k_len / 2.0)
            for b = 0 to num_blocks - 1
                int start_idx = random_in_range(seed_val + b * 29, 0, pool_size - 2)
                array.push(sample_out, array.get(pool, start_idx))
                if array.size(sample_out) < k_len
                    array.push(sample_out, array.get(pool, start_idx + 1))
                    
        else if mode == "Sign-Flipping Drift"
            for step = 0 to k_len - 1
                int r_idx = random_in_range(seed_val + step * 23, 0, pool_size - 1)
                float val = array.get(pool, r_idx)
                bool flip = random_in_range(seed_val + step * 71, 0, 1) == 1
                array.push(sample_out, flip ? -val : val)
                
        else // Uniform Shuffle
            array<float> temp_copy = array.copy(pool)
            for step = 0 to math.min(k_len, pool_size) - 1
                int r_idx = random_in_range(seed_val + step * 13, 0, array.size(temp_copy) - 1)
                array.push(sample_out, array.get(temp_copy, r_idx))
                array.remove(temp_copy, r_idx)
                
    sample_out

//---------------------------------------------------------------------------------------------------------------------}
// 5. Execution Dispatcher (Throttle & Replay Control)
//---------------------------------------------------------------------------------------------------------------------{
bool time_trigger = (timenow - last_calc_time) >= (throttle_sec * 1000)
bool should_calc  = false

if barstate.islast
    if time_trigger or last_calc_time == 0
        should_calc := true
        last_calc_time := timenow
else if replay_mode and barstate.isnew
    should_calc := true

//---------------------------------------------------------------------------------------------------------------------}
// 6. 3-Day Forward Simulation Execution & Band Construction
//---------------------------------------------------------------------------------------------------------------------{
var float ref_u_band   = na
var float ref_l_band   = na
var float ref_m_band   = na
var float bullish_prob = 50.0
var float exp_vol_3d   = 0.0

if should_calc and array.size(can_ary) >= 10
    all_runs = array.new<fa>(0)
    int up_count = 0
    
    // 1. Eksekusi N Replays sepanjang 3 Hari Forward Horizon
    for run = 1 to num_replays
        int run_seed = (bar_index * 1337 + run * 79 + (timenow % 99991))
        array<float> path_samples = build_mc_permutation(can_ary, forward_bars, var_method, run_seed)
        
        array<float> single_run_path = array.new_float(0)
        float cur_p = close
        
        for step = 0 to array.size(path_samples) - 1
            cur_p += array.get(path_samples, step)
            array.push(single_run_path, cur_p)
            
        if array.size(single_run_path) > 0 and array.last(single_run_path) > close
            up_count += 1
            
        array.push(all_runs, fa.new(single_run_path))

    // Probabilitas Arah (Directional Bias %)
    bullish_prob := (up_count / float(num_replays)) * 100.0

    // 2. Transposisi Vertikal
    all_vertical = array.new<fa>(0)
    for step = 0 to forward_bars - 1
        vert_slice = array.new_float(0)
        for r = 0 to num_replays - 1
            fa r_obj = array.get(all_runs, r)
            array.push(vert_slice, array.get(r_obj.ary, step))
        array.push(all_vertical, fa.new(vert_slice))

    // 3. Ekstraksi Profil Koordinat Pita
    array<chart.point> outer_top = array.new<chart.point>(0)
    array<chart.point> outer_bot = array.new<chart.point>(0)
    array<chart.point> dev_top   = array.new<chart.point>(0)
    array<chart.point> dev_bot   = array.new<chart.point>(0)
    array<chart.point> mean_pts  = array.new<chart.point>(0)

    chart.point origin_pt = chart.point.from_index(bar_index, close)
    array.push(mean_pts, origin_pt)

    float p_day1 = na
    float p_day2 = na
    float p_day3 = na
    float d3_max = na
    float d3_min = na

    for step = 0 to forward_bars - 1
        fa v_data = array.get(all_vertical, step)
        array<float> v_ary = v_data.ary
        
        float v_mean  = array.avg(v_ary)
        float v_max   = array.max(v_ary)
        float v_min   = array.min(v_ary)
        float v_stdev = array.stdev(v_ary)
        
        int target_x = bar_index + step + 1
        
        if step == 0
            ref_m_band := v_mean
            ref_u_band := v_mean + (v_stdev * stdev_multi)
            ref_l_band := v_mean - (v_stdev * stdev_multi)
            
        // Rekam milestone hari (Day 1, 2, 3)
        if step == math.min(forward_bars - 1, bars_per_1d - 1)
            p_day1 := v_mean
        if step == math.min(forward_bars - 1, (bars_per_1d * 2) - 1)
            p_day2 := v_mean
        if step == forward_bars - 1
            p_day3 := v_mean
            d3_max := v_max
            d3_min := v_min
            exp_vol_3d := ((v_max - v_min) / close) * 100.0

        float u_dev = v_mean + (v_stdev * stdev_multi)
        float l_dev = v_mean - (v_stdev * stdev_multi)
        
        array.push(outer_top, chart.point.from_index(target_x, v_max))
        array.unshift(outer_bot, chart.point.from_index(target_x, v_min))
        
        array.push(dev_top, chart.point.from_index(target_x, u_dev))
        array.unshift(dev_bot, chart.point.from_index(target_x, l_dev))
        
        array.push(mean_pts, chart.point.from_index(target_x, v_mean))

    // 4. Konstruksi Poligon Pita Tertutup
    array<chart.point> shadow_poly_pts = array.new<chart.point>(0)
    array.push(shadow_poly_pts, origin_pt)
    for p in outer_top
        array.push(shadow_poly_pts, p)
    for p in outer_bot
        array.push(shadow_poly_pts, p)

    array<chart.point> dev_poly_pts = array.new<chart.point>(0)
    array.push(dev_poly_pts, origin_pt)
    for p in dev_top
        array.push(dev_poly_pts, p)
    for p in dev_bot
        array.push(dev_poly_pts, p)

    // 5. Bersihkan & Render Visual Baru
    if not na(shadow_poly)
        polyline.delete(shadow_poly)
    if not na(stdev_poly)
        polyline.delete(stdev_poly)
    if not na(mean_poly)
        polyline.delete(mean_poly)
    if not na(lbl_day1)
        label.delete(lbl_day1)
    if not na(lbl_day2)
        label.delete(lbl_day2)
    if not na(lbl_day3)
        label.delete(lbl_day3)
    if not na(ln_day1)
        line.delete(ln_day1)
    if not na(ln_day2)
        line.delete(ln_day2)
    if not na(ln_day3)
        line.delete(ln_day3)

    if show_shadow
        shadow_poly := polyline.new(shadow_poly_pts, line_color = color.new(c_shadow, 100), fill_color = c_shadow)
    if show_stdev
        stdev_poly  := polyline.new(dev_poly_pts, line_color = color.new(c_stdev, 90), fill_color = c_stdev)
    if show_mean
        mean_poly   := polyline.new(mean_pts, line_color = c_mean)

    // 6. Forward Milestone Markers (Day 1, 2, 3 Projected Targets)
    if show_milest and not na(p_day3)
        int x_d1 = bar_index + math.min(forward_bars, bars_per_1d)
        int x_d2 = bar_index + math.min(forward_bars, bars_per_1d * 2)
        int x_d3 = bar_index + forward_bars

        if not na(p_day1) and x_d1 < x_d3
            ln_day1  := line.new(x_d1, close, x_d1, p_day1, color = color.new(c_mean, 60), style = line.style_dotted)
            lbl_day1 := label.new(x_d1, p_day1, "+24h: " + str.tostring(p_day1, "#.##"), style = label.style_label_down, color = color.new(#1e222d, 20), textcolor = c_mean, size = size.tiny)
            
        if not na(p_day2) and x_d2 < x_d3
            ln_day2  := line.new(x_d2, close, x_d2, p_day2, color = color.new(c_mean, 60), style = line.style_dotted)
            lbl_day2 := label.new(x_d2, p_day2, "+48h: " + str.tostring(p_day2, "#.##"), style = label.style_label_down, color = color.new(#1e222d, 20), textcolor = c_mean, size = size.tiny)

        ln_day3  := line.new(x_d3, d3_min, x_d3, d3_max, color = c_mean, width = 2, style = line.style_dashed)
        lbl_day3 := label.new(x_d3, p_day3, "Day 3 Target\n" + str.tostring(p_day3, "#.##") + "\n[" + str.tostring(d3_min, "#.##") + " - " + str.tostring(d3_max, "#.##") + "]", style = label.style_label_left, color = color.new(#1e222d, 10), textcolor = color.white, size = size.small)

//---------------------------------------------------------------------------------------------------------------------}
// 7. Modern Quantitative HUD Dashboard Box
//---------------------------------------------------------------------------------------------------------------------{
if show_hud and barstate.islast
    string tbl_pos = position.top_right
    if hud_position == "Bottom Right"
        tbl_pos := position.bottom_right
    else if hud_position == "Top Left"
        tbl_pos := position.top_left

    if na(hud_tbl)
        hud_tbl := table.new(tbl_pos, 2, 5, bgcolor = color.new(#131722, 10), border_color = color.new(#363c4e, 30), border_width = 1)

    table.cell(hud_tbl, 0, 0, "Forward Horizon", bgcolor = color.new(#1e222d, 0), text_color = color.white, text_size = size.small)
    table.cell(hud_tbl, 1, 0, "+3 Days (" + str.tostring(forward_bars) + " Bars)", bgcolor = color.new(#1e222d, 0), text_color = c_mean, text_size = size.small)

    table.cell(hud_tbl, 0, 1, "Monte Carlo Runs", bgcolor = color.new(#1e222d, 0), text_color = color.gray, text_size = size.small)
    table.cell(hud_tbl, 1, 1, str.tostring(num_replays) + " Paths", bgcolor = color.new(#1e222d, 0), text_color = color.white, text_size = size.small)

    table.cell(hud_tbl, 0, 2, "Directional Bias", bgcolor = color.new(#1e222d, 0), text_color = color.gray, text_size = size.small)
    color bias_col = bullish_prob >= 50.0 ? #00e676 : #ff5252
    string bias_txt = str.tostring(bullish_prob, "#.#") + "% Bullish"
    table.cell(hud_tbl, 1, 2, bias_txt, bgcolor = color.new(#1e222d, 0), text_color = bias_col, text_size = size.small)

    table.cell(hud_tbl, 0, 3, "3-Day Expected Vol", bgcolor = color.new(#1e222d, 0), text_color = color.gray, text_size = size.small)
    table.cell(hud_tbl, 1, 3, "±" + str.tostring(exp_vol_3d, "#.##") + "%", bgcolor = color.new(#1e222d, 0), text_color = #ffeb3b, text_size = size.small)

    table.cell(hud_tbl, 0, 4, "Refresh Throttle", bgcolor = color.new(#1e222d, 0), text_color = color.gray, text_size = size.small)
    table.cell(hud_tbl, 1, 4, str.tostring(throttle_sec) + "s Auto", bgcolor = color.new(#1e222d, 0), text_color = color.white, text_size = size.small)

//---------------------------------------------------------------------------------------------------------------------}
// 8. Strategy Entry Templates Evaluator
//---------------------------------------------------------------------------------------------------------------------{
bool buy_sig  = false
bool sell_sig = false

if enable_entry and not na(ref_u_band) and not na(ref_l_band) and not na(ref_m_band)
    
    // Template 1: Mean Reversion (Touch / Fade)
    if strat_type == "Mean Reversion: Touch / Fade"
        buy_sig  := low <= ref_l_band and close > ref_l_band
        sell_sig := high >= ref_u_band and close < ref_u_band

    // Template 2: Mean Reversion (Re-entry Confirmation)
    else if strat_type == "Mean Reversion: Re-entry Confirmation"
        buy_sig  := close[1] < ref_l_band and close > ref_l_band
        sell_sig := close[1] > ref_u_band and close < ref_u_band

    // Template 3: Volatility Breakout (Momentum Expansion)
    else if strat_type == "Volatility Breakout: Momentum Expansion"
        buy_sig  := ta.crossover(close, ref_u_band)
        sell_sig := ta.crossunder(close, ref_l_band)

    // Template 4: Mean Path Pullback (Trend Retest)
    else if strat_type == "Mean Path Pullback: Trend Retest"
        bool slope_up = ref_m_band > close[1]
        bool slope_dn = ref_m_band < close[1]
        buy_sig  := slope_up and ta.crossover(close, ref_m_band)
        sell_sig := slope_dn and ta.crossunder(close, ref_m_band)

    // Template 5: Asymmetric Quantitative Skew Bias
    else if strat_type == "Asymmetric Skew: Quantitative Probability Bias"
        buy_sig  := bullish_prob >= prob_skew_pct and ta.crossover(close, open)
        sell_sig := (100.0 - bullish_prob) >= prob_skew_pct and ta.crossunder(close, open)

// Plot Sinyal Entry
plotshape(buy_sig, title = "MC Buy Signal", style = shape.triangleup, location = location.belowbar, color = #00e676, size = size.small, text = "BUY")
plotshape(sell_sig, title = "MC Sell Signal", style = shape.triangledown, location = location.abovebar, color = #ff5252, size = size.small, text = "SELL")

// Alert Triggers
alertcondition(buy_sig, title = "Monte Carlo 3D BUY Signal", message = "Monte Carlo 3D Forward: BUY on {{ticker}} at {{close}}")
alertcondition(sell_sig, title = "Monte Carlo 3D SELL Signal", message = "Monte Carlo 3D Forward: SELL on {{ticker}} at {{close}}")
